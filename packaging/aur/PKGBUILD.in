# Maintainer: Nabil Bin Sayed <nabilprometheus@gmail.com>
# Generated by .github/workflows/release.yml from packaging/aur/PKGBUILD.in (Plan 098).
pkgname=beziernotes-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="PDF-native handwriting notebook and annotator: ink lives inside standard PDFs"
arch=('x86_64')
url="https://github.com/nabilbinsayed/BezierNotes"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'fuse2')
provides=('beziernotes')
conflicts=('beziernotes')
options=('!strip')
source=("BezierNotes_${pkgver}_amd64.AppImage::https://github.com/nabilbinsayed/BezierNotes/releases/download/v${pkgver}/@APPIMAGE@")
sha256sums=('@SHA256@')

package() {
  install -Dm755 "BezierNotes_${pkgver}_amd64.AppImage" "$pkgdir/opt/beziernotes/BezierNotes.AppImage"
  install -dm755 "$pkgdir/usr/bin"
  ln -s /opt/beziernotes/BezierNotes.AppImage "$pkgdir/usr/bin/beziernotes"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/beziernotes.desktop" <<DESKTOP
[Desktop Entry]
Name=BezierNotes
GenericName=PDF Ink Annotator
Exec=beziernotes %U
Icon=beziernotes
Terminal=false
Type=Application
Categories=Office;Graphics;Viewer;
MimeType=application/pdf;
DESKTOP
}
